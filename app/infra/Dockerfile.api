# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS base
RUN apk add --no-cache openssl
RUN corepack enable && corepack prepare pnpm@11.4.0 --activate
WORKDIR /repo

FROM base AS deps
RUN apk add --no-cache python3 make g++
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY shared/package.json shared/
COPY backend/package.json backend/
COPY frontend/package.json frontend/
COPY tests/e2e/package.json tests/e2e/
RUN pnpm install --frozen-lockfile

FROM base AS build
COPY --from=deps /repo/node_modules ./node_modules
COPY --from=deps /repo/shared/node_modules ./shared/node_modules
COPY --from=deps /repo/backend/node_modules ./backend/node_modules
COPY . .
RUN pnpm --filter @prsi/shared exec prisma generate && \
    PNPM_PRISMA_DIR=$(find node_modules/.pnpm -type d -path '*@prisma+client@*/node_modules/.prisma/client' | head -1) && \
    [ -n "$PNPM_PRISMA_DIR" ] || (echo "ERROR: pnpm @prisma/client placeholder not found under node_modules/.pnpm" >&2 && exit 1) && \
    cp -r shared/node_modules/.prisma/client/. "$PNPM_PRISMA_DIR/"
RUN pnpm --filter @prsi/backend typecheck

FROM node:22-alpine AS runtime
RUN apk add --no-cache openssl
ENV NODE_ENV=production
WORKDIR /repo
COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/shared ./shared
COPY --from=build /repo/backend ./backend
COPY --from=build /repo/package.json ./package.json
COPY --from=build /repo/pnpm-workspace.yaml ./pnpm-workspace.yaml
WORKDIR /repo/backend
EXPOSE 3001
# Run prisma migrate deploy from the shared workspace before starting the
# Fastify server. migrate deploy is idempotent (skips already-applied migrations)
# so this is safe on every container start. If migrations fail, the process exits
# non-zero and Render flags the deploy as failed instead of serving a broken API.
CMD ["sh", "-c", "cd /repo/shared && node_modules/.bin/prisma migrate deploy && cd /repo/backend && exec node_modules/.bin/tsx src/index.ts"]
