    "fastify": "4.28.1",
    "ioredis": "5.4.1",
    "jsonwebtoken": "9.0.2",
    "openai": "4.78.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "20.16.5",
    "@types/ws": "8.5.13",
    "pino-pretty": "11.2.2",
