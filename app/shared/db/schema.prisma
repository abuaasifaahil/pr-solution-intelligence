generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  analyst
  viewer
}

enum ChatStatus {
  active
  completed
  archived
}

enum MessageRole {
  user
  assistant
  system
}

enum DataSourceType {
  meltwater
  opoint
  webz
  twitter
  infovision
  custom
}

enum MCPStatus {
  active
  inactive
  error
}

enum LLMProvider {
  claude
  gpt
  ollama
  perplexity
}

enum UploadStatus {
  uploading
  parsing
  ready
  error
}

enum FlowState {
  init
  collect_dates
  collect_enrichment
  collect_brand
  collect_competitors
  collect_intention
  generate_query
  processing
  complete
}

enum DateRangeType {
  weekly
  ten_days
  twenty_days
  custom
  auto_detected
}

enum EnrichmentType {
  standard
  reach
}

enum CompetitorSet {
  top5
  top3
  top2
  custom
}

enum Intention {
  intention_based
  comment_based
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  displayName  String    @map("display_name") @db.VarChar(100)
  role         UserRole  @default(analyst)
  preferences  Json      @default("{}")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  sessions       Session[]
  chats          Chat[]
  dataSources    DataSource[]
  mcpConnections MCPConnection[]
  llmConfigs     LLMConfig[]
  userSkills     UserSkill[]
  uploads        Upload[]
  articles       Article[]
  chatParams     ChatParams[]
  enrichments    Enrichment[]
  enrichmentJobs EnrichmentJob[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  ipAddress String?  @map("ip_address") @db.Inet
  userAgent String?  @map("user_agent")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([expiresAt])
  @@map("sessions")
}

model Chat {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  agentType String     @map("agent_type") @db.VarChar(50)
  title     String?    @db.VarChar(255)
  status    ChatStatus @default(active)
  context   Json       @default("{}")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       Message[]
  uploads        Upload[]
  articles       Article[]
  chatParams     ChatParams?
  booleanQueries BooleanQuery[]
  enrichments    Enrichment[]
  enrichmentJobs EnrichmentJob[]

  @@index([userId, status])
  @@index([createdAt])
  @@map("chats")
}

model Message {
  id        String      @id @default(uuid()) @db.Uuid
  chatId    String      @map("chat_id") @db.Uuid
  role      MessageRole
  content   String
  metadata  Json        @default("{}")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("messages")
}

model Agent {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(100)
  type         String   @unique @db.VarChar(50)
  description  String
  capabilities Json     @default("[]")
  icon         String?  @db.VarChar(50)
  color        String?  @db.VarChar(7)
  isDefault    Boolean  @default(false) @map("is_default")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  logs AgentLog[]

  @@map("agents")
}

model AgentLog {
  id         String   @id @default(uuid()) @db.Uuid
  agentId    String   @map("agent_id") @db.Uuid
  action     String   @db.VarChar(50)
  input      Json     @default("{}")
  output     Json     @default("{}")
  durationMs Int      @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@map("agent_logs")
}

model DataSource {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  sourceType      DataSourceType @map("source_type")
  displayName     String         @map("display_name") @db.VarChar(100)
  apiKeyEncrypted String         @map("api_key_encrypted")
  endpointUrl     String?        @map("endpoint_url") @db.VarChar(500)
  config          Json           @default("{}")
  isActive        Boolean        @default(true) @map("is_active")
  lastTestedAt    DateTime?      @map("last_tested_at") @db.Timestamptz
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("data_sources")
}

model MCPConnection {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  sourceName     String    @map("source_name") @db.VarChar(100)
  serverUrl      String    @map("server_url") @db.VarChar(500)
  tokenEncrypted String    @map("token_encrypted")
  status         MCPStatus @default(inactive)
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Timestamptz
  availableTools Json      @default("[]") @map("available_tools")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mcp_connections")
}

model LLMConfig {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  provider        LLMProvider
  modelName       String      @map("model_name") @db.VarChar(100)
  apiKeyEncrypted String?     @map("api_key_encrypted")
  maxTokens       Int         @default(4096) @map("max_tokens")
  temperature     Decimal     @default(0.3) @db.Decimal(3, 2)
  isDefault       Boolean     @default(false) @map("is_default")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("llm_configs")
}

model Skill {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique @db.VarChar(100)
  description   String
  type          String   @db.VarChar(50)
  handlerConfig Json     @default("{}") @map("handler_config")
  isDefault     Boolean  @default(false) @map("is_default")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  userSkills UserSkill[]

  @@map("skills")
}

model UserSkill {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  skillId   String   @map("skill_id") @db.Uuid
  isEnabled Boolean  @default(true) @map("is_enabled")
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@map("user_skills")
}

// ─── Phase 2: Data Pipeline ───────────────────────────────────────────────

model Upload {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  chatId         String       @map("chat_id") @db.Uuid
  filename       String       @db.VarChar(255)
  mimeType       String       @map("mime_type") @db.VarChar(50)
  filePath       String       @map("file_path") @db.VarChar(500)
  sizeBytes      BigInt       @map("size_bytes")
  rowCount       Int?         @map("row_count")
  columnCount    Int?         @map("column_count")
  schemaDetected Json         @default("[]") @map("schema_detected")
  dateColumn     String?      @map("date_column") @db.VarChar(100)
  dateRangeStart DateTime?    @map("date_range_start") @db.Date
  dateRangeEnd   DateTime?    @map("date_range_end") @db.Date
  status         UploadStatus @default(uploading)
  errorMessage   String?      @map("error_message")
  parsedAt       DateTime?    @map("parsed_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat       Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  articles   Article[]
  chatParams ChatParams? @relation("ChatParamsUpload")

  @@index([userId, chatId])
  @@index([status])
  @@index([createdAt])
  @@map("uploads")
}

model Article {
  id              String    @id @default(uuid()) @db.Uuid
  uploadId        String?   @map("upload_id") @db.Uuid
  chatId          String    @map("chat_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  title           String
  content         String?
  description     String?
  source          String?   @db.VarChar(255)
  author          String?   @db.VarChar(255)
  publishedDate   DateTime? @map("published_date") @db.Date
  url             String?
  publisherDomain String?   @map("publisher_domain") @db.VarChar(255)
  language        String    @default("en") @db.VarChar(10)
  rawData         Json      @default("{}") @map("raw_data")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  upload     Upload?     @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  chat       Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrichment Enrichment?

  @@index([chatId])
  @@index([userId])
  @@index([uploadId])
  @@index([publishedDate])
  @@index([publisherDomain])
  @@map("articles")
}

model ChatParams {
  id             String          @id @default(uuid()) @db.Uuid
  chatId         String          @unique @map("chat_id") @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  flowState      FlowState       @default(init) @map("flow_state")
  dateRangeType  DateRangeType?  @map("date_range_type")
  dateStart      DateTime?       @map("date_start") @db.Date
  dateEnd        DateTime?       @map("date_end") @db.Date
  enrichmentType EnrichmentType? @map("enrichment_type")
  reachThreshold Int?            @map("reach_threshold")
  brand          String?         @db.VarChar(255)
  competitors    Json            @default("[]")
  competitorSet  CompetitorSet?  @map("competitor_set")
  intention      Intention?
  hasUpload      Boolean         @default(false) @map("has_upload")
  uploadId       String?         @unique @map("upload_id") @db.Uuid
  collectedAt    DateTime?       @map("collected_at") @db.Timestamptz
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  chat           Chat           @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  upload         Upload?        @relation("ChatParamsUpload", fields: [uploadId], references: [id], onDelete: SetNull)
  booleanQueries BooleanQuery[]

  @@map("chat_params")
}

model BooleanQuery {
  id              String    @id @default(uuid()) @db.Uuid
  chatId          String    @map("chat_id") @db.Uuid
  chatParamsId    String    @map("chat_params_id") @db.Uuid
  queryText       String    @map("query_text")
  queryStructured Json      @map("query_structured")
  version         Int       @default(1)
  isConfirmed     Boolean   @default(false) @map("is_confirmed")
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  chat       Chat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatParams ChatParams @relation(fields: [chatParamsId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@map("boolean_queries")
}

// ─── Phase 3: Enrichment Engine ───────────────────────────────────────────

enum EnrichmentJobType {
  standard
  reach
}

enum EnrichmentJobStatus {
  queued
  processing
  completed
  failed
  partial
}

enum EnrichmentBatchStatus {
  pending
  processing
  completed
  failed
  retrying
}

model Enrichment {
  id        String  @id @default(uuid()) @db.Uuid
  articleId String  @unique @map("article_id") @db.Uuid
  chatId    String  @map("chat_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  batchId   String? @map("batch_id") @db.Uuid

  sentiment        Json
  themes           Json
  emotion          Json
  entities         Json
  signals          Json
  reach            Json?
  socialEngagement Json? @map("social_engagement")

  modelUsed    String   @map("model_used") @db.VarChar(100)
  tokensInput  Int      @map("tokens_input")
  tokensOutput Int      @map("tokens_output")
  processingMs Int      @map("processing_ms")
  isValid      Boolean  @default(true) @map("is_valid")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  article Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  chat    Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch   EnrichmentBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([chatId])
  @@index([userId])
  @@map("enrichments")
}

model EnrichmentJob {
  id                String              @id @default(uuid()) @db.Uuid
  chatId            String              @map("chat_id") @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  totalArticles     Int                 @map("total_articles")
  processedCount    Int                 @default(0) @map("processed_count")
  batchCount        Int                 @map("batch_count")
  batchesCompleted  Int                 @default(0) @map("batches_completed")
  modelUsed         String              @map("model_used") @db.VarChar(100)
  enrichmentType    EnrichmentJobType   @map("enrichment_type")
  totalTokensInput  BigInt              @default(0) @map("total_tokens_input")
  totalTokensOutput BigInt              @default(0) @map("total_tokens_output")
  status            EnrichmentJobStatus @default(queued)
  startedAt         DateTime?           @map("started_at") @db.Timestamptz
  completedAt       DateTime?           @map("completed_at") @db.Timestamptz
  errorLog          Json                @default("[]") @map("error_log")
  dashboardJson     Json?               @map("dashboard_json")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz

  chat    Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  batches EnrichmentBatch[]

  @@index([chatId])
  @@index([userId])
  @@index([status])
  @@map("enrichment_jobs")
}

model EnrichmentBatch {
  id              String                @id @default(uuid()) @db.Uuid
  jobId           String                @map("job_id") @db.Uuid
  batchNumber     Int                   @map("batch_number")
  articleIds      String[]              @map("article_ids") @db.Uuid
  estimatedTokens Int                   @map("estimated_tokens")
  actualTokensIn  Int?                  @map("actual_tokens_in")
  actualTokensOut Int?                  @map("actual_tokens_out")
  status          EnrichmentBatchStatus @default(pending)
  retryCount      Int                   @default(0) @map("retry_count")
  processingMs    Int?                  @map("processing_ms")
  error           String?
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz

  job         EnrichmentJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  enrichments Enrichment[]

  @@index([jobId])
  @@map("enrichment_batches")
}

model ReachCache {
  id              String   @id @default(uuid()) @db.Uuid
  domain          String   @unique @db.VarChar(255)
  monthlyVisitors BigInt?  @map("monthly_visitors")
  globalRank      Int?     @map("global_rank")
  category        String?  @db.VarChar(100)
  score           Int?
  rawResponse     Json     @default("{}") @map("raw_response")
  fetchedAt       DateTime @default(now()) @map("fetched_at") @db.Timestamptz
  ttlHours        Int      @default(168) @map("ttl_hours")
  isValid         Boolean  @default(true) @map("is_valid")

  @@index([fetchedAt])
  @@map("reach_cache")
}
